---
import AzureCloudExplainer from "./AzureCloudExplainer";
import ExplainerPageIntro from "./ExplainerPageIntro.astro";
import { getAzureCloudTopicByRoute } from "../data/azureCloudTopics/index";

interface Props { route: string; }
const topic = getAzureCloudTopicByRoute(Astro.props.route);
const canonical = `https://explainers.uppercut-labs.workers.dev/${topic.route}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#07111f" />
    <meta name="description" content={topic.summary} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Explainers" />
    <meta property="og:title" content={topic.title} />
    <meta property="og:description" content={topic.summary} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://explainers.uppercut-labs.workers.dev/icons/app-icon-512.png" />
    <title>{topic.title} — Explainers</title>
    <meta name="application-name" content="Uppercut Labs Explainers" />
    <meta name="apple-mobile-web-app-title" content="Explainers" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="mobile-web-app-capable" content="yes" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" href="/icons/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <script is:inline src="/pwa.js" defer></script>
    <style>html,body{min-height:100%;margin:0;background:#07111f}</style>
  </head>
  <body class="explainer-page-with-intro">
    <ExplainerPageIntro title={topic.title} hook={topic.summary} />
    <AzureCloudExplainer topic={topic} client:load />
  </body>
</html>
